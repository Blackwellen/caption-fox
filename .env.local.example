# ── Supabase (REQUIRED) ─────────────────────────────────────────────
# Without these the middleware throws and every route returns 500.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── App (REQUIRED in production) ────────────────────────────────────
# Public base URL of the deployment. Used for auth redirects / links.
# Local: http://localhost:3004   Production: https://caption-fox.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3004

# ── AI (REQUIRED for AI features) ───────────────────────────────────
# Used by /api/ai/generate, /api/ai/chat, /api/ai/image.
# Get one at https://console.anthropic.com — without it AI routes 500.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Optional ────────────────────────────────────────────────────────
# Stability AI key for image generation in /api/ai/image (falls back if absent).
STABILITY_API_KEY=

# Supabase CLI personal access token (LOCAL TOOLING ONLY — do NOT add to Vercel).
SUPABASE_ACCESS_TOKEN=

# Development-only application-shell demo. /shell is available while running next dev;
# production keeps it hidden unless this is explicitly set to true. Never enable it live.
NEXT_PUBLIC_CAPTION_FOX_SHELL_DEMO=false

# Advertising: AES-256-GCM key for provider credentials.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADVERTISING_ENCRYPTION_KEY=

# ── Messaging ───────────────────────────────────────────────────────
# Email sending (Resend). Without these, Email Messaging truthfully reports
# "not connected" instead of sending. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
MESSAGING_EMAIL_FROM="Your Brand <hello@yourdomain.com>"
# Signing secret for the Resend webhook you create pointing at
# https://<your-domain>/api/messaging/webhooks/resend, subscribed to:
# email.sent, email.delivered, email.opened, email.clicked, email.bounced,
# email.complained, email.failed, email.delivery_delayed. Without this,
# delivered/opened/clicked counts stay at zero (reported honestly, not faked).
RESEND_WEBHOOK_SECRET=
# Shared secret for POST /api/messaging/journeys/tick (drives journey waits and
# sends). Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Then schedule a POST to this route with `Authorization: Bearer <secret>` every
# few minutes (Vercel Cron, GitHub Actions, or any external scheduler).
MESSAGING_JOBS_SECRET=
# SMS sending (Twilio). Without these, SMS Messaging truthfully reports
# "not connected". Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service SID (recommended — handles sender pooling/10DLC)
# or a single from-number in E.164 format (+15551234567). Set one.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# WhatsApp, RCS and Push each require your own provider account (Meta WhatsApp
# Business, an RCS agent, FCM/APNs). Caption Fox never holds or provisions
# these credentials — a concrete adapter for each is a later build phase;
# until then those channels report "not connected" at Messaging → Channels.

# ── Partnerships: Stripe Connect payouts ─────────────────────────────
# STRIPE_SECRET_KEY / STRIPE_SECRET_KEY_TEST are shared with the rest of the
# app's Stripe billing integration. Partnerships payouts always use the TEST
# key outside production (see src/lib/partnerships/stripe.ts), so local dev
# and QA can never move real money.
# Webhook: create an endpoint in the Stripe dashboard for account.updated,
# transfer.updated and transfer.reversed, pointed at
# https://<your-domain>/api/webhooks/partnerships-stripe, then paste its
# signing secret below. Without this set, that route returns 503 and partner
# Stripe status only updates when someone clicks "Refresh status" manually.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Public site canonical origin (used for canonical URLs, sitemap.xml, robots.txt, JSON-LD). Set to the production domain in Vercel.
NEXT_PUBLIC_SITE_URL=https://caption-fox.vercel.app

# Cloudflare R2 (private bucket for brand assets, agreements, product imagery)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS=
CLOUDFLARE_R2_S3_API=
CLOUDFLARE_S3_BUCKET=
